          "port": 14321,
          "mitm_port": 14322,
          "health": { "kind": "http", "url": "http://vault:14321/v1/mitm/ca.pem" }
        },
        "cliproxy": {
          "port": 8317,
          "health": { "kind": "tcp", "host": "vault", "port": 8317 }
        },
        "relay-8000": {
          "port": 8000,
          "health": { "kind": "tcp", "host": "vault", "port": 8000 }
        },
        "relay-8765": {
          "port": 8765,
          "health": { "kind": "tcp", "host": "vault", "port": 8765 }
        }
      }
    },
    "bluebubbles": {
