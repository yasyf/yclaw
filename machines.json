{
  "_comment": "CANONICAL machines manifest — the single source of truth for the yclaw fleet's nodes, services, tailnet tags, virtiofs shares, keychain services, and host state paths. Consumed by THREE readers: (1) bash via jq (scripts/lib/manifest.sh: manifest_get / manifest_list), (2) nix via builtins.fromJSON, (3) the future yclaw Python CLI. Ports here MIRROR tailnet/policy.hujson (hermes->metal tcp:8000,8765,8317,14321,14322 hermes->bluebubbles tcp:443, and the metal->host grant tag:metal -> yasyf-home tcp:8000,8765 for rapid-mlx + stt on the bare host, backstopped by the host pf anchor com.apple/000.yclaw.host that scripts/host/host-pf.sh installs — a com.apple child so the stock pf.conf's wildcard call evaluates it from the first targeted load, 000 so it sorts ahead of Apple's own children; the same anchor also shuts the fleet's vmnet side-door, 192.168.64.0/24 -> every host address (pf self) blocked outside DHCP/DNS) — keep the two in sync; darwin/metal.nix DERIVES its pf anchor port set from here. Health kind=http is used ONLY for endpoints verified to answer an unauthenticated GET (rapid-mlx /v1/models, agent-vault /v1/mitm/ca.pem); every other port is kind=tcp (reachability only). Debloat label lists are per-node: darwin/metal.nix derives its disable loops from debloat.metal, scripts/bluebubbles-setup.sh copies debloat.bluebubbles VERBATIM — bluebubbles is a deliberate SUBSET of metal, never merge them.",
  "machines": {
    "metal": {
      "os": "macos",
      "managed_by": "nix-darwin",
      "tart_vm": "metal",
      "tag": "tag:metal",
      "ssh": { "transport": "tailscale", "user": "root" },
      "admin_pass_keychain": "yclaw-metal-admin-pass",
      "shares": ["metalsecrets", "agentvault", "cliproxy", "repo"],
      "services": {
        "rapid-mlx": {
          "launchd": { "domain": "system", "label": "org.nixos.rapid-mlx" },
          "port": 8000,
          "health": { "kind": "http", "url": "http://metal:8000/v1/models" },
          "logs": [
            "/Users/admin/Library/Logs/rapid-mlx/rapid-mlx.log",
            "/Users/admin/Library/Logs/rapid-mlx/rapid-mlx.error.log"
          ]
        },
        "mlx-audio": {
          "launchd": { "domain": "system", "label": "org.nixos.mlx-audio" },
          "port": 8765,
          "health": { "kind": "tcp", "host": "metal", "port": 8765 },
          "logs": [
            "/Users/admin/Library/Logs/mlx-audio/stt.log",
            "/Users/admin/Library/Logs/mlx-audio/stt.error.log"
          ]
        },
        "cliproxy": {
          "launchd": { "domain": "system", "label": "org.nixos.cliproxy" },
          "port": 8317,
          "health": { "kind": "tcp", "host": "metal", "port": 8317 },
          "logs": [
            "/Users/admin/Library/Logs/cliproxy/proxy.log",
            "/Users/admin/Library/Logs/cliproxy/proxy.error.log"
          ]
        },
        "agent-vault": {
          "launchd": { "domain": "system", "label": "org.nixos.agent-vault" },
          "port": 14321,
          "mitm_port": 14322,
          "health": { "kind": "http", "url": "http://metal:14321/v1/mitm/ca.pem" },
          "logs": [
            "/Users/admin/Library/Logs/agent-vault/server.log",
            "/Users/admin/Library/Logs/agent-vault/server.error.log"
          ]
        },
        "agent-vault-provision": {
          "launchd": { "domain": "system", "label": "org.nixos.agent-vault-provision" },
          "oneshot": true,
          "logs": [
            "/Users/admin/Library/Logs/agent-vault/provision.log",
            "/Users/admin/Library/Logs/agent-vault/provision.error.log"
          ]
        },
        "metal-boot-setup": {
          "launchd": { "domain": "system", "label": "org.nixos.metal-boot-setup" },
          "oneshot": true,
          "logs": [
            "/var/log/metal-boot-setup.log",
            "/var/log/metal-boot-setup.error.log"
          ]
        },
        "metal-pf-refresh": {
          "launchd": { "domain": "system", "label": "org.nixos.metal-pf-refresh" },
          "oneshot": false,
          "logs": [
            "/var/log/metal-pf-refresh.log",
            "/var/log/metal-pf-refresh.error.log"
          ]
        }
      }
    },
    "hermes": {
      "os": "linux",
      "managed_by": "container",
      "tart_vm": null,
      "container": "hermes",
      "tag": "tag:hermes",
      "ssh": null,
      "admin_pass_keychain": null,
      "shares": null,
      "services": {
        "hermes-agent": { "container_proc": "hermes gateway run" }
      }
    },
    "vault": {
      "os": "linux",
      "managed_by": "container",
      "tart_vm": null,
      "container": "vault",
      "tag": "tag:vault",
      "ssh": null,
