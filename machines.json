          ]
        },
        "stt": {
          "launchd": { "domain": "gui", "label": "com.yclaw.stt" },
          "port": 8765,
          "health": { "kind": "tcp", "host": "yasyf-home", "port": 8765 },
          "logs": [
            "~/Library/Logs/yclaw/stt.log",
            "~/Library/Logs/yclaw/stt.error.log"
          ]
        },
        "host-pf-refresh": {
          "launchd": { "domain": "system", "label": "com.yclaw.host-pf-refresh" },
          "oneshot": false,
          "logs": [
            "/var/log/host-pf-refresh.log",
            "/var/log/host-pf-refresh.error.log"
          ]
        },
        "container-hermes": {
          "launchd": { "domain": "gui", "label": "com.yclaw.container-hermes" },
          "oneshot": false,
          "logs": [
            "~/Library/Logs/yclaw/container-hermes.log",
            "~/Library/Logs/yclaw/container-hermes.error.log"
          ]
        },
        "container-vault": {
          "launchd": { "domain": "gui", "label": "com.yclaw.container-vault" },
          "oneshot": false,
          "logs": [
            "~/Library/Logs/yclaw/container-vault.log",
            "~/Library/Logs/yclaw/container-vault.error.log"
          ]
        },
        "container-pf-refresh": {
          "launchd": { "domain": "system", "label": "com.yclaw.container-pf-refresh" },
          "oneshot": false,
          "logs": [
