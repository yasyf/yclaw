        "rapid-mlx": {
          "launchd": { "domain": "gui", "label": "com.yclaw.rapid-mlx" },
          "port": 8000,
          "health": { "kind": "http", "url": "http://yasyf-home:8000/v1/models" },
          "logs": [
            "~/Library/Logs/yclaw/rapid-mlx.log",
